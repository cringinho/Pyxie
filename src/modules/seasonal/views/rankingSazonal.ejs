    function applyTranslations() {
      const dict = I18N[currentLang] || I18N.pt;
      document.querySelectorAll('[data-i18n]').forEach(el => {
        const key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });
      const isEn = currentLang === 'en';
      document.querySelectorAll('.monetization-pt').forEach(el => {
        el.style.display = isEn ? 'none' : '';
      });
      document.querySelectorAll('.monetization-en').forEach(el => {
        el.style.display = isEn ? '' : 'none';
      });
      const input = document.getElementById('playerSearchInput');
      if (input && dict['search.placeholder']) input.placeholder = dict['search.placeholder'];
      const btnLang = document.getElementById('btnLang');
      if (btnLang) btnLang.innerHTML = currentLang === 'en' ? '<span>🇺🇸 EN</span>' : '<span>🇧🇷 PT-BR</span>';
    }

    function toggleLang() {
      currentLang = currentLang === 'pt' ? 'en' : 'pt';
      applyTranslations();
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('lang', currentLang);
        window.history.replaceState({}, '', url);
      } catch (_) {}
      renderUI();

      // Atualiza card preview se o modal estiver aberto
      const cardImg = document.getElementById('shareCardImg');
      if (cardImg) {
        const overlay = document.getElementById('cardLoadingOverlay');
        if (overlay) overlay.style.display = 'flex';
        cardImg.src = `/api/sazonal/card.png?lang=${currentLang}&t=${Date.now()}`;
      }
    }

    // Modal de Compartilhamento Viral
    function openShareModal() {
      const modal = document.getElementById('shareModal');
      const img = document.getElementById('shareCardImg');
      const overlay = document.getElementById('cardLoadingOverlay');
      if (!modal) return;
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      const targetSrc = `/api/sazonal/card.png?lang=${currentLang}&t=${Date.now()}`;
      if (img) {
        if (overlay) overlay.style.display = 'flex';
        img.src = targetSrc;
      }
    }

    function closeShareModal() {
      const modal = document.getElementById('shareModal');
      if (modal) modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    function onCardImgLoaded() {
      const overlay = document.getElementById('cardLoadingOverlay');
      if (overlay) overlay.style.display = 'none';
    }

    function downloadCard() {
      const link = document.createElement('a');
      link.href = `/api/sazonal/card.png?lang=${currentLang}&download=true&t=${Date.now()}`;
      link.download = 'ranking-cringelandia.png';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      showShareToast(I18N[currentLang]['share.copied'] || 'Download iniciado!');
    }

    async function copyCard() {
      const btn = document.getElementById('copyBtnText');
      const dict = I18N[currentLang] || I18N.pt;
      const originalText = dict['share.btnCopy'];
      try {
        if (btn) btn.textContent = dict['share.copying'];
        const res = await fetch(`/api/sazonal/card.png?lang=${currentLang}`);
        const blob = await res.blob();
        if (navigator.clipboard && navigator.clipboard.write) {
          await navigator.clipboard.write([
            new ClipboardItem({ 'image/png': blob })
          ]);
          showShareToast(dict['share.copied']);
        } else {
          showShareToast(dict['share.copied']);
        }
      } catch (err) {
        console.warn('Erro ao copiar imagem:', err);
        downloadCard();
      } finally {
        if (btn) btn.textContent = originalText;
      }
    }

    function shareTwitter() {
      const dict = I18N[currentLang] || I18N.pt;
      const text = encodeURIComponent(dict['share.tweetText']);
      const url = encodeURIComponent('https://pyxie.duckdns.org/evento?lang=' + currentLang);
      window.open(`https://twitter.com/intent/tweet?text=${text}&url=${url}&hashtags=Cringelandia,PyxieBot,Discord`, '_blank');
    }

    function shareWhatsApp() {
      const dict = I18N[currentLang] || I18N.pt;
      const text = encodeURIComponent(dict['share.tweetText'] + ' https://pyxie.duckdns.org/evento?lang=' + currentLang + ' (Convite: https://discord.gg/b3uZK3ssfX)');
      window.open(`https://api.whatsapp.com/send?text=${text}`, '_blank');
    }

    async function copyDiscordInvite() {
      const inviteUrl = 'https://discord.gg/b3uZK3ssfX';
      try {
        await navigator.clipboard.writeText(inviteUrl);
        showShareToast('Convite do Discord copiado!');
      } catch (_) {
        const inp = document.createElement('input');
        inp.value = inviteUrl;
        document.body.appendChild(inp);
        inp.select();
        document.execCommand('copy');
        document.body.removeChild(inp);
        showShareToast('Convite do Discord copiado!');
      }
    }

    function showShareToast(message) {
      const toast = document.getElementById('shareToast');
      if (!toast) return;
      toast.textContent = message;
      toast.style.display = 'block';
      setTimeout(() => {
        toast.style.display = 'none';
      }, 3000);
    }

    // Countdown Timer
    function startCountdown() {
      const targetDate = new Date(END_DATE_ISO).getTime();
      function update() {
        const now = Date.now();
        const diff = Math.max(0, targetDate - now);
        
        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
        const mins = Math.floor((diff / (1000 * 60)) % 60);
        const secs = Math.floor((diff / 1000) % 60);

        document.getElementById('dNum').textContent = String(days).padStart(2, '0');
        document.getElementById('hNum').textContent = String(hours).padStart(2, '0');
        document.getElementById('mNum').textContent = String(mins).padStart(2, '0');
        document.getElementById('sNum').textContent = String(secs).padStart(2, '0');
      }
      update();
      setInterval(update, 1000);
    }

    // Renderização dos Componentes
    function renderUI() {
      if (!liveData) return;
      const dict = I18N[currentLang] || I18N.pt;
      const lb = liveData.leaderboard || [];
      const maxScore = lb.length > 0 ? (lb[0].balance || 1) : 1;

      // 1. Pódio (Top 3)
      const podiumEl = document.getElementById('podiumContainer');
      const first = lb[0] || null;
      const second = lb[1] || null;
      const third = lb[2] || null;

      function createPodiumCard(entry, posClass, medal, rankNum) {
        if (!entry) {
          return `
            <div class="podium-card ${posClass}">
              <div class="avatar-wrap">
                <img class="avatar-img" src="https://cdn.discordapp.com/embed/avatars/0.png" alt="Empty" style="opacity: 0.35;" />
                <span class="podium-badge">${medal}</span>
              </div>
              <div class="podium-name" style="opacity: 0.5;">${dict['empty.podium']}</div>
              <div class="podium-tag">#${rankNum}</div>
              <div class="podium-score" style="opacity: 0.4;">
                <img src="${CURRENCY_EMOJI_URL}" alt="pumpkin" /> 0
              </div>
            </div>
          `;
        }
        return `
          <div class="podium-card ${posClass}">
            ${posClass === 'first' ? '<span class="crown-icon">👑</span>' : ''}
            <div class="avatar-wrap">
              <img class="avatar-img" src="${entry.avatarUrl}" alt="${entry.displayName}" />
              <span class="podium-badge">${medal}</span>
            </div>
            <div class="podium-name" title="${entry.displayName}">${entry.displayName}</div>
            <div class="podium-tag">${entry.username}</div>
            <div class="podium-score">
              <img src="${CURRENCY_EMOJI_URL}" alt="pumpkin" />
              <span>${entry.balance} ${CURRENCY_NAME}</span>
            </div>
          </div>
        `;
      }

      podiumEl.innerHTML = 
        createPodiumCard(second, 'second', '🥈', 2) +
        createPodiumCard(first, 'first', '🥇', 1) +
        createPodiumCard(third, 'third', '🥉', 3);

      // 2. Tabela de Classificação
      renderTable(lb, maxScore);

      // 3. Galeria de Artes da Semana
      const artGrid = document.getElementById('artGalleryGrid');
      const arts = liveData.currentWeekArt || [];
      if (arts.length === 0) {
        artGrid.innerHTML = `<div style="grid-column: 1 / -1; text-align: center; color: var(--text-muted); padding: 2rem;">${dict['empty.art']}</div>`;
      } else {
        artGrid.innerHTML = arts.map(art => `
          <div class="art-card">
            <div class="art-img-wrap">
              <img class="art-img" src="${art.imageUrl}" alt="${art.authorName}" loading="lazy" />
            </div>
            <div class="art-info">
              <div class="art-author">
                <img class="art-avatar" src="${art.authorAvatar}" alt="${art.authorName}" />
                <span class="art-author-name">${art.authorName}</span>
              </div>
              <div class="art-vote-badge">
                <img src="https://cdn.discordapp.com/emojis/1548443988745261086.gif" width="16" height="16" alt="vote" />
                <span>${dict['art.voting']}</span>
              </div>
            </div>
          </div>
        `).join('');
      }
    }

    function renderTable(list, maxScore) {
      const tbody = document.getElementById('rankingTableBody');
      const dict = I18N[currentLang] || I18N.pt;
      if (!list || list.length === 0) {
        tbody.innerHTML = `<tr><td colspan="3" style="text-align: center; color: var(--text-muted); padding: 2.5rem;">${dict['empty.table']}</td></tr>`;
        return;
      }

      tbody.innerHTML = list.map((item, idx) => {
        const pct = Math.min(100, Math.max(12, Math.round((item.balance / maxScore) * 100)));
        const rankMedal = idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : `#${idx + 1}`;
        return `
          <tr data-username="${item.displayName.toLowerCase()} ${item.username.toLowerCase()}">
            <td>
              <span class="rank-number ${idx < 3 ? 'top' : ''}">${rankMedal}</span>
            </td>
            <td>
              <div class="user-cell">
                <img class="user-avatar-sm" src="${item.avatarUrl}" alt="${item.displayName}" />
                <div class="user-details">
                  <span class="user-name-text">${item.displayName}</span>
                  <span class="user-subtext">${item.username}</span>
                </div>
              </div>
            </td>
            <td>
              <div class="score-cell">
                <img src="${CURRENCY_EMOJI_URL}" alt="pumpkin" />
                <span>${item.balance} ${CURRENCY_NAME}</span>
              </div>
              <div class="bar-container">
                <div class="bar-fill" style="width: ${pct}%;"></div>
              </div>
            </td>
          </tr>
        `;
      }).join('');
    }

    function filterTable() {
      const query = (document.getElementById('playerSearchInput')?.value || '').toLowerCase().trim();
      document.querySelectorAll('#rankingTableBody tr').forEach(row => {
        const text = row.getAttribute('data-username') || '';
        if (!query || text.includes(query)) {
          row.style.display = '';
        } else {
          row.style.display = 'none';
        }
      });
    }

    // Polling Automático em Tempo Real (Live Fetch)
    async function fetchRankingLive() {
      try {
        const res = await fetch('/api/sazonal/ranking');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.success) {
          liveData = data;
          renderUI();
        }
      } catch (err) {
        console.warn('Erro ao atualizar ranking:', err);
      }
    }

    // Spooky Floating Particle Canvas
    (function initParticles() {
      const canvas = document.getElementById('particlesCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      let width = canvas.width = window.innerWidth;
      let height = canvas.height = window.innerHeight;

      window.addEventListener('resize', () => {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });

      const particles = Array.from({ length: 42 }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 2.2 + 0.6,
        dx: (Math.random() - 0.5) * 0.45,
        dy: (Math.random() - 0.5) * 0.45,
        alpha: Math.random() * 0.6 + 0.2,
        color: Math.random() > 0.4 ? '#8b5cf6' : '#ff7b00'
      }));

      function loop() {
        ctx.clearRect(0, 0, width, height);
        for (const p of particles) {
          p.x += p.dx;
          p.y += p.dy;
          if (p.x < 0) p.x = width;
          if (p.x > width) p.x = 0;
          if (p.y < 0) p.y = height;
          if (p.y > height) p.y = 0;

          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.color;
          ctx.globalAlpha = p.alpha;
          ctx.shadowBlur = p.r * 3;
          ctx.shadowColor = p.color;
          ctx.fill();
        }
        requestAnimationFrame(loop);
      }
      loop();
    })();

    async function syncHourlyPromoLinks() {
      try {
        const res = await fetch('/api/shopee/hourly-promo');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.success && data.promo && data.promo.affiliateLink) {
          document.querySelectorAll('[data-hourly-promo="true"]').forEach(el => {
            el.setAttribute('href', data.promo.affiliateLink);
          });
        }
      } catch (_) {}
    }

    // Inicialização
    document.addEventListener('DOMContentLoaded', () => {
      applyTranslations();
      startCountdown();
      fetchRankingLive();
      syncHourlyPromoLinks();
      // Atualiza automaticamente a cada 15 segundos
      setInterval(fetchRankingLive, 15000);
      setInterval(syncHourlyPromoLinks, 60000);
    });
  </script>
