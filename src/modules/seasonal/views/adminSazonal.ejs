      </div>
    <!-- Modal Seletor de Emojis do Discord da Pyxie -->
    <div class="emoji-modal-backdrop" id="seasonalEmojiModal" style="display: none;" onclick="handleModalBackdropClick(event)">
      <div class="emoji-modal" onclick="event.stopPropagation()">
        <div class="emoji-modal-header">
          <div>
            <h3>🎨 Galeria de Emojis da Pyxie</h3>
            <p id="pickerTargetLabel">Selecione um emoji para o evento</p>
          </div>
          <button type="button" class="btn-close-modal" onclick="closePicker()">✕</button>
        </div>

        <div class="emoji-search-box">
          <div class="input-with-icon">
            <span class="icon">🔍</span>
            <input type="text" id="emojiPickerSearch" placeholder="Pesquisar por nome ou ID..." oninput="onPickerSearchInput()" />
          </div>

          <div class="quick-filters">
            <button type="button" class="filter-chip active" data-filter="all" onclick="setPickerFilter('all')">Todos (<span id="countAll">0</span>)</button>
            <button type="button" class="filter-chip" data-filter="halloween" onclick="setPickerFilter('halloween')">🎃 Halloween / Trevas</button>
            <button type="button" class="filter-chip" data-filter="animated" onclick="setPickerFilter('animated')">✨ Animados</button>
            <button type="button" class="filter-chip" data-filter="static" onclick="setPickerFilter('static')">🖼️ Estáticos</button>
          </div>
        </div>

        <div class="emoji-picker-grid" id="pickerGrid">
          <!-- Renderizado via Javascript -->
        </div>

        <div class="emoji-modal-footer">
          <span style="font-size:0.75rem; color: var(--text-muted);" id="pickerStatusText">Carregando emojis...</span>
          <button type="button" class="btn btn-secondary btn-sm" onclick="closePicker()">Fechar</button>
        </div>
      </div>
    </div>

    <div id="toast"></div>

    <script>
      let currentTab = 'infoevento';

      // Catálogo de Emojis da Pyxie vindo do servidor
      const ALL_DISCORD_EMOJIS = <%- JSON.stringify(appEmojis || []) %>;
      const emojiMapById = new Map();
      const emojiMapByName = new Map();

      for (const e of ALL_DISCORD_EMOJIS) {
        emojiMapById.set(String(e.id), e);
        if (e.name) emojiMapByName.set(e.name.toLowerCase(), e);
      }

      // Estado do Seletor
      let currentPickerField = null;
      let currentPickerMode = 'single'; // 'single' ou 'multi'
      let activePickerFilter = 'all';
      let pickerSearchQuery = '';

      const DEFAULT_HALLOWEEN_DECOYS = [
        '1548443801515720719', // ardiscordzombie
        '1548444196074033242', // purplecandy
        '1548443994902757427', // halloweenabobora
        '1548444056982655099', // kuromiwitch
        '1548443998283235461', // halloweenpokemon
        '1548443839247818802', // cafehalloweenbat
      ];

      function getEmojiInfo(idOrName) {
        if (!idOrName) return { id: '', name: 'Vazio', url: null, isUnicode: false, raw: '' };
        const str = String(idOrName).trim();

        // 1. Unicode direto
        if (/\p{Extended_Pictographic}/u.test(str)) {
          return { id: str, name: str, url: null, isUnicode: true, raw: str };
        }

        // 2. ID no catálogo de Application Emojis da Pyxie
        if (emojiMapById.has(str)) {
          const item = emojiMapById.get(str);
          return {
            id: item.id,
            name: item.name,
            animated: item.animated,
            url: item.url || `https://cdn.discordapp.com/emojis/${item.id}.${item.animated ? 'gif' : 'png'}`,
            isUnicode: false,
            raw: str,
          };
        }

        // 3. Nome no catálogo
        const lower = str.toLowerCase();
        if (emojiMapByName.has(lower)) {
          const item = emojiMapByName.get(lower);
          return {
            id: item.id,
            name: item.name,
            animated: item.animated,
            url: item.url || `https://cdn.discordapp.com/emojis/${item.id}.${item.animated ? 'gif' : 'png'}`,
            isUnicode: false,
            raw: str,
          };
        }

        // 4. Se for número de snowflake
        if (/^\d{17,21}$/.test(str)) {
          return {
            id: str,
            name: `Emoji (${str.slice(0, 6)}...)`,
            animated: false,
            url: `https://cdn.discordapp.com/emojis/${str}.png`,
            isUnicode: false,
            raw: str,
          };
        }

        // 5. Fallback para nomes textuais antigos
        const knownFallbacks = {
          '5479_kindergarten': { name: 'Kindergarten', fallback: '🎃' },
          '82336witchscaul': { name: 'Caldeirão', fallback: '🍲' },
          '4124hellokit': { name: 'Hello Kitty', fallback: '🐱' },
          'ardiscordzomb': { name: 'Zumbi', fallback: '🧟' },
          'purplecandy': { name: 'Bala Roxa', fallback: '🍬' },
          '31772purpleween': { name: 'Purpleween', fallback: '🎃' },
          'witchwumpus': { name: 'Wumpus Bruxo', fallback: '🧙' },
          '8320_hallowee': { name: 'Halloween Art', fallback: '🎨' },
          '36577halloween': { name: 'Halloween Frame', fallback: '🖼️' },
          'halloweenpokemon': { name: 'Halloween Poke', fallback: '🦇' },
          'halloweentot8': { name: 'Ghost Tot', fallback: '👻' },
          'halloween3gif55': { name: 'Halloween Web', fallback: '🕸️' },
          'cafehalloweenbat': { name: 'Cafe Bat', fallback: '🦇' },
          'halloween47': { name: 'Halloween Candle', fallback: '🕯️' },
        };

        if (knownFallbacks[lower]) {
          return {
            id: str,
            name: knownFallbacks[lower].name,
            url: null,
            fallbackText: knownFallbacks[lower].fallback,
            isUnicode: true,
            raw: str,
          };
        }

        return { id: str, name: str, url: null, isUnicode: false, raw: str };
      }

      function renderCurrencySlot() {
        const val = document.getElementById('emojiCurrency')?.value.trim();
        const info = getEmojiInfo(val);

        const previewEl = document.getElementById('slotCurrencyPreview');
        const nameEl = document.getElementById('slotCurrencyName');
        const idEl = document.getElementById('slotCurrencyId');

        if (previewEl) {
          if (info.url) {
            previewEl.innerHTML = `<img src="${info.url}" alt="${info.name}" />`;
          } else if (info.fallbackText) {
            previewEl.textContent = info.fallbackText;
          } else {
            previewEl.textContent = info.name || '🎃';
          }
        }

        if (nameEl) nameEl.textContent = info.name || 'Emoji Padrão';
        if (idEl) idEl.textContent = info.id ? `ID: ${info.id}` : 'Sem ID vinculado';
      }

      function renderChips(fieldId) {
        const input = document.getElementById(fieldId);
        if (!input) return;

        const containerId = fieldId === 'dropDecoys' ? 'chipsDecoys' :
                            fieldId === 'artOfWeek' ? 'chipsArt' :
                            fieldId === 'trickOrTreat' ? 'chipsTrickOrTreat' :
                            fieldId === 'dailyClaim' ? 'chipsDailyClaim' : null;

        const badgeId = fieldId === 'dropDecoys' ? 'badgeCountDecoys' :
                        fieldId === 'artOfWeek' ? 'badgeCountArt' :
                        fieldId === 'trickOrTreat' ? 'badgeCountTrick' :
                        fieldId === 'dailyClaim' ? 'badgeCountDaily' : null;

        const container = document.getElementById(containerId);
        if (!container) return;

        const items = (input.value || '')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        if (badgeId) {
          const badgeEl = document.getElementById(badgeId);
          if (badgeEl) badgeEl.textContent = `${items.length} ${items.length === 1 ? 'Emoji' : 'Emojis'}`;
        }

        if (items.length === 0) {
          container.innerHTML = `<span style="font-size: 0.8rem; color: var(--text-muted); font-style: italic;">Nenhum emoji selecionado. Clique no botão abaixo para adicionar.</span>`;
          return;
        }

        container.innerHTML = items.map(item => {
          const info = getEmojiInfo(item);
          const icon = info.url
            ? `<img src="${info.url}" alt="${info.name}" />`
            : `<span>${info.fallbackText || (info.isUnicode ? info.name : '❓')}</span>`;

          return `
            <div class="emoji-chip" title="ID: ${info.id || info.name}">
              ${icon}
              <span class="chip-name">${info.name}</span>
              <button type="button" class="chip-remove" onclick="removeEmojiFromField('${fieldId}', '${item}')" title="Remover este emoji">✕</button>
            </div>
          `;
        }).join('');
      }

      function removeEmojiFromField(fieldId, itemToRemove) {
        const input = document.getElementById(fieldId);
        if (!input) return;

        const items = (input.value || '')
          .split(',')
          .map(s => s.trim())
          .filter(Boolean);

        const filtered = items.filter(x => x !== itemToRemove);
        input.value = filtered.join(',');
        renderChips(fieldId);
        updateLivePreview();
        showToast('Emoji removido da lista!');
      }

      function resetCurrencyEmoji() {
        const input = document.getElementById('emojiCurrency');
        if (input) {
          input.value = '1548443994902757427';
          renderCurrencySlot();
          updateLivePreview();
          showToast('Emoji da moeda restaurado para o padrão (halloweenabobora)!');
        }
      }

      function resetDefaultDecoys() {
        const input = document.getElementById('dropDecoys');
        if (input) {
          input.value = DEFAULT_HALLOWEEN_DECOYS.join(',');
          renderChips('dropDecoys');
          updateLivePreview();
          showToast('Lista de 6 decoys restaurada para o padrão oficial de Halloween!');
        }
      }

      function openPicker(fieldId, mode = 'single') {
        currentPickerField = fieldId;
        currentPickerMode = mode;
        activePickerFilter = 'all';
        pickerSearchQuery = '';

        const fieldLabels = {
          currency: 'Moeda Sazonal (currency)',
          dropDecoys: 'Emojis Decoys do Baú (dropDecoys)',
          artOfWeek: 'Votação da Arte da Semana (artOfWeek)',
          trickOrTreat: 'Gostosuras ou Travessuras (trickOrTreat)',
          dailyClaim: 'Reivindicação Diária (dailyClaim)',
        };

        const labelEl = document.getElementById('pickerTargetLabel');
        if (labelEl) {
          labelEl.textContent = `Configurando: ${fieldLabels[fieldId] || fieldId} • Modo: ${mode === 'single' ? 'Substituição Única' : 'Múltiplos Itens'}`;
        }

        const searchInput = document.getElementById('emojiPickerSearch');
        if (searchInput) searchInput.value = '';

        document.querySelectorAll('.filter-chip').forEach(c => {
          c.classList.toggle('active', c.getAttribute('data-filter') === 'all');
        });

        const modal = document.getElementById('seasonalEmojiModal');
        if (modal) modal.style.display = 'flex';

        const countAllEl = document.getElementById('countAll');
        if (countAllEl) countAllEl.textContent = ALL_DISCORD_EMOJIS.length;

        renderPickerGrid();
      }

      function closePicker() {
        const modal = document.getElementById('seasonalEmojiModal');
        if (modal) modal.style.display = 'none';
        currentPickerField = null;
      }

      function handleModalBackdropClick(e) {
        if (e.target && e.target.id === 'seasonalEmojiModal') {
          closePicker();
        }
      }

      function setPickerFilter(filterName) {
        activePickerFilter = filterName;
        document.querySelectorAll('.filter-chip').forEach(c => {
          c.classList.toggle('active', c.getAttribute('data-filter') === filterName);
        });
        renderPickerGrid();
      }

      function onPickerSearchInput() {
        pickerSearchQuery = (document.getElementById('emojiPickerSearch')?.value || '').trim().toLowerCase();
        renderPickerGrid();
      }

      const HALLOWEEN_KEYWORDS = ['hallow', 'witch', 'bat', 'zomb', 'candy', 'ghost', 'spooky', 'pumpk', 'abobora', 'bone', 'skull', 'knife', 'dark', 'goth', 'kuromi', 'demon', 'blood', 'boo', 'scary', 'spider', 'web'];

      function renderPickerGrid() {
        const grid = document.getElementById('pickerGrid');
        const statusEl = document.getElementById('pickerStatusText');
        if (!grid) return;

        let filtered = ALL_DISCORD_EMOJIS;

        // Filtro por categoria
        if (activePickerFilter === 'halloween') {
          filtered = filtered.filter(e => {
            const nameLower = (e.name || '').toLowerCase();
            return HALLOWEEN_KEYWORDS.some(kw => nameLower.includes(kw));
          });
        } else if (activePickerFilter === 'animated') {
          filtered = filtered.filter(e => e.animated);
        } else if (activePickerFilter === 'static') {
          filtered = filtered.filter(e => !e.animated);
        }

        // Filtro por busca textual
        if (pickerSearchQuery) {
          filtered = filtered.filter(e => {
            const nameMatch = (e.name || '').toLowerCase().includes(pickerSearchQuery);
            const idMatch = String(e.id || '').includes(pickerSearchQuery);
            return nameMatch || idMatch;
          });
        }

        const totalResults = filtered.length;
        if (statusEl) {
          statusEl.textContent = `Exibindo ${Math.min(totalResults, 200)} de ${totalResults} emojis encontrados • Clique em qualquer um para selecionar`;
        }

        if (totalResults === 0) {
          grid.innerHTML = `
            <div style="grid-column: 1 / -1; text-align: center; padding: 40px 10px; color: var(--text-muted);">
              <div style="font-size: 2.2rem; margin-bottom: 8px;">🕸️</div>
              <p style="font-weight: 600;">Nenhum emoji encontrado com os filtros atuais.</p>
              <span style="font-size: 0.8rem;">Tente pesquisar por outro termo ou limpar os filtros.</span>
            </div>
          `;
          return;
        }

        // Renderiza no máximo 200 por performance instantânea
        const toRender = filtered.slice(0, 200);

        grid.innerHTML = toRender.map(e => {
          const animTag = e.animated ? `<span class="anim-tag">GIF</span>` : '';
          return `
            <div class="emoji-picker-card" onclick="selectEmojiInPicker('${e.id}')" title="${e.name} (${e.id})">
              ${animTag}
              <img src="${e.url}" alt="${e.name}" loading="lazy" />
              <div class="emoji-picker-name">${e.name}</div>
            </div>
          `;
        }).join('');
      }

      function selectEmojiInPicker(emojiId) {
        if (!currentPickerField) return;
        const info = getEmojiInfo(emojiId);

        if (currentPickerMode === 'single') {
          const input = document.getElementById(currentPickerField);
          if (input) {
            input.value = emojiId;
          }
          if (currentPickerField === 'currency' || currentPickerField === 'emojiCurrency') {
            const currencyInput = document.getElementById('emojiCurrency');
            if (currencyInput) currencyInput.value = emojiId;
            renderCurrencySlot();
          }
          updateLivePreview();
          closePicker();
          showToast(`Emoji "${info.name}" selecionado com sucesso!`);
        } else {
          // Multi mode (chips)
          const input = document.getElementById(currentPickerField);
          if (input) {
            const currentItems = (input.value || '')
              .split(',')
              .map(s => s.trim())
              .filter(Boolean);

            if (currentItems.includes(emojiId)) {
              showToast(`O emoji "${info.name}" já está na lista!`, 'error');
              return;
            }

            currentItems.push(emojiId);
            input.value = currentItems.join(',');
            renderChips(currentPickerField);
            updateLivePreview();
            showToast(`Emoji "${info.name}" adicionado à lista!`);
          }
        }
      }

      function showToast(msg, type = 'success') {
        const toast = document.getElementById('toast');
        toast.textContent = msg;
        toast.className = type;
        toast.style.display = 'block';
        setTimeout(() => {
          toast.style.display = 'none';
        }, 3500);
      }

      function switchPreviewTab(tab, btn) {
        currentTab = tab;
        document.querySelectorAll('.tab-buttons .tab-btn').forEach(b => b.classList.remove('active'));
        if (btn) {
          btn.classList.add('active');
        } else if (window.event && window.event.target) {
          window.event.target.classList.add('active');
        }
        updateLivePreview();
      }

      function updateLivePreview() {
        const eventName = document.getElementById('eventName')?.value || 'Evento Sazonal';
        const currencyName = document.getElementById('currencyName')?.value || 'Moedas';
        const firstPrize = document.getElementById('firstPlace')?.value || 'Discord Nitro';
        const secondPrize = document.getElementById('secondPlace')?.value || '';
        const thirdPrize = document.getElementById('thirdPlace')?.value || '';
        const footer = document.getElementById('dropEmbedFooter')?.value || 'Dica: Use /py-infoevento para entender a pontuação e prazos!';
        const emojiCurrency = document.getElementById('emojiCurrency')?.value || '🎃';
        const chestUrl = document.getElementById('chestImageUrl')?.value.trim();
        const infoUrl = document.getElementById('infoEventImageUrl')?.value.trim();
        const endDateVal = document.getElementById('endDate')?.value || '';
        const timezoneVal = document.getElementById('timezone')?.value || 'America/Sao_Paulo';
        const artChannel = document.getElementById('artChannelId')?.value ? `#${document.getElementById('artChannelId').value}` : '#canal-de-artes';
        const dropsChannel = document.getElementById('dropsChannelId')?.value ? `#${document.getElementById('dropsChannelId').value}` : '#canal-de-drops';

        const titleEl = document.getElementById('previewTitle');
        const descEl = document.getElementById('previewDesc');
        const fieldsEl = document.getElementById('previewFields');
        const footerEl = document.getElementById('previewFooter');
        const previewImgEl = document.getElementById('previewImg');

        if (footerEl) footerEl.textContent = footer;

        if (currentTab === 'infoevento') {
          // Imagem do Guia (usa infoEventImageUrl ou fallback para chestImageUrl)
          const imgToUse = infoUrl || chestUrl;
          if (imgToUse && previewImgEl) {
            previewImgEl.src = imgToUse;
            previewImgEl.style.display = 'block';
          } else if (previewImgEl) {
            previewImgEl.style.display = 'none';
          }

          // Título
          let rawTitle = document.getElementById('infoEventTitle')?.value || '🕸️ {eventName} — GUIA OFICIAL 🕸️';
          titleEl.textContent = rawTitle.replace(/{eventName}/g, eventName.toUpperCase());

          // Descrição
          let rawDesc = document.getElementById('infoEventDescription')?.value || 'Bem-vindo(a) ao evento temático oficial da Cringelândia! Participe das atividades, acumule **{currencyName}** e dispute os prêmios no topo do placar.';
          rawDesc = rawDesc.replace(/{eventName}/g, eventName)
                           .replace(/{currencyName}/g, currencyName)
                           .replace(/{firstPrize}/g, firstPrize);
          descEl.textContent = rawDesc;

          // Fields
          fieldsEl.innerHTML = '';

          // 1. Saldo
          const currInfo = getEmojiInfo(emojiCurrency);
          const currIconHtml = currInfo.url
            ? `<img src="${currInfo.url}" alt="${currInfo.name}" style="width:18px;height:18px;vertical-align:middle;object-fit:contain;display:inline-block;margin:0 2px;" />`
            : (currInfo.fallbackText || (currInfo.isUnicode ? currInfo.name : '🎃'));

          const fBalance = document.createElement('div');
          fBalance.className = 'preview-field';
          fBalance.innerHTML = `
            <div class="preview-field-title">🪙 Seu Saldo Sazonal</div>
            <div class="preview-field-val">&gt; Atualmente você possui <strong>42</strong> ${currIconHtml} <strong>${currencyName}</strong></div>
          `;
          fieldsEl.appendChild(fBalance);

          // 2. Como Funciona & Regras
          let rawRules = document.getElementById('infoEventRules')?.value || '';
          rawRules = rawRules.replace(/{eventName}/g, eventName)
                             .replace(/{currencyName}/g, currencyName)
                             .replace(/{dropsChannel}/g, dropsChannel)
                             .replace(/{artChannel}/g, artChannel)
                             .replace(/{firstPrize}/g, firstPrize);
          const fRules = document.createElement('div');
          fRules.className = 'preview-field';
          fRules.innerHTML = `
            <div class="preview-field-title">📖 Como Funciona & Regras do Evento</div>
            <div class="preview-field-val">${rawRules}</div>
          `;
          fieldsEl.appendChild(fRules);

          // 3. Tabela de Premiações
          const prizeItems = [];
          if (firstPrize) prizeItems.push(`🥇 <strong>1º Lugar:</strong> ${firstPrize}`);
          if (secondPrize) prizeItems.push(`🥈 <strong>2º Lugar:</strong> ${secondPrize}`);
          if (thirdPrize) prizeItems.push(`🥉 <strong>3º Lugar:</strong> ${thirdPrize}`);
          const fPrizes = document.createElement('div');
          fPrizes.className = 'preview-field';
          fPrizes.innerHTML = `
            <div class="preview-field-title">🏆 Tabela de Premiações</div>
            <div class="preview-field-val">${prizeItems.length ? prizeItems.join('<br>') : '&gt; <em>Premiações em definição pela moderação.</em>'}</div>
          `;
          fieldsEl.appendChild(fPrizes);

          // 4. Campo Extra (se preenchido)
          let rawExtra = document.getElementById('infoEventExtra')?.value || '';
          if (rawExtra.trim().length > 0) {
            rawExtra = rawExtra.replace(/{eventName}/g, eventName)
                               .replace(/{currencyName}/g, currencyName)
                               .replace(/{firstPrize}/g, firstPrize);
            const fExtra = document.createElement('div');
            fExtra.className = 'preview-field';
            fExtra.innerHTML = `
              <div class="preview-field-title">💡 Informações & Dicas da Pyxie</div>
              <div class="preview-field-val">${rawExtra}</div>
            `;
            fieldsEl.appendChild(fExtra);
          }

          // 5. Prazo de Encerramento
          let formattedEnd = endDateVal || 'Em breve';
          try {
            const d = new Date(endDateVal);
            if (!isNaN(d.getTime())) {
              formattedEnd = d.toLocaleString('pt-BR', { timeZone: timezoneVal, dateStyle: 'full', timeStyle: 'medium' });
            }
          } catch (_) {}
          const fDeadline = document.createElement('div');
          fDeadline.className = 'preview-field';
          fDeadline.innerHTML = `
            <div class="preview-field-title">⏳ Prazo de Encerramento</div>
            <div class="preview-field-val">&gt; <strong>${formattedEnd}</strong><br>&gt; <em>(Fuso Horário Oficial: ${timezoneVal})</em></div>
          `;
          fieldsEl.appendChild(fDeadline);

        } else {
          // Outras abas (announcement, drop, art)
          fieldsEl.innerHTML = '';
          if (chestUrl && previewImgEl) {
            previewImgEl.src = chestUrl;
            previewImgEl.style.display = 'block';
          }

          if (currentTab === 'announcement') {
            titleEl.textContent = `🕸️ ${eventName.toUpperCase()} 🕸️`;
            let raw = document.getElementById('announcementText').value;
            raw = raw.replace(/{eventName}/g, eventName)
                     .replace(/{currencyName}/g, currencyName)
                     .replace(/{firstPrize}/g, firstPrize);
            descEl.textContent = raw;
          } else if (currentTab === 'drop') {
            titleEl.textContent = '🎃 BAÚ MISTERIOSO DA PYXIE DESPENCOU! 🎃';
            descEl.textContent = `Um baú suspeito caiu com tudo no meio da Cringelândia!\n\n⚡ Rápido! Clique na reação 🎃 **Abóbora Maligna** antes dos outros para abrir o baú!\n\n*Apenas o primeiro a acertar leva o saque.*`;
          } else if (currentTab === 'art') {
            titleEl.textContent = '🎨 ARTE DA SEMANA DEFINIDA!';
            let raw = document.getElementById('artOfWeekWinner').value;
            raw = raw.replace(/{author}/g, '@ArtistaTalentoso')
                     .replace(/{currencyName}/g, currencyName);
            descEl.textContent = `${raw}\n\nTotal de Votos: 14 🗳️`;
          }
        }
      }

      async function saveConfiguration() {
        const dropDecoys = (document.getElementById('dropDecoys')?.value || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        const artOfWeek = (document.getElementById('artOfWeek')?.value || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        const trickOrTreat = (document.getElementById('trickOrTreat')?.value || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        const dailyClaim = (document.getElementById('dailyClaim')?.value || '')
          .split(',')
          .map((s) => s.trim())
          .filter(Boolean);

        const currency = document.getElementById('emojiCurrency')?.value.trim() || '5479_Kindergarten';
        const chestImageUrl = document.getElementById('chestImageUrl')?.value.trim() || '';
        const infoEventImageUrl = document.getElementById('infoEventImageUrl')?.value.trim() || '';

        const payload = {
          eventName: document.getElementById('eventName').value,
          currencyName: document.getElementById('currencyName').value,
          channels: {
            artChannelId: document.getElementById('artChannelId').value.trim(),
            dropsChannelId: document.getElementById('dropsChannelId').value.trim(),
            announcementsChannelId: document.getElementById('announcementsChannelId').value.trim(),
          },
          dates: {
            endDate: document.getElementById('endDate').value.trim(),
            timezone: document.getElementById('timezone').value.trim(),
          },
          prizes: {
            firstPlace: document.getElementById('firstPlace').value,
            secondPlace: document.getElementById('secondPlace').value,
            thirdPlace: document.getElementById('thirdPlace').value,
          },
          assets: {
            chestImageUrl,
            infoEventImageUrl,
            emojis: {
              currency,
              dropDecoys,
              artOfWeek,
              trickOrTreat,
              dailyClaim,
            },
          },
          templates: {
            announcementText: document.getElementById('announcementText').value,
            dropEmbedFooter: document.getElementById('dropEmbedFooter').value,
            artOfWeekWinner: document.getElementById('artOfWeekWinner').value,
            infoEventTitle: document.getElementById('infoEventTitle')?.value || '',
            infoEventDescription: document.getElementById('infoEventDescription')?.value || '',
            infoEventRules: document.getElementById('infoEventRules')?.value || '',
            infoEventExtra: document.getElementById('infoEventExtra')?.value || '',
          },
        };

        try {
          const res = await fetch('/api/admin/sazonal/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const json = await res.json();
          if (json.success) {
            showToast('Configurações salvas com sucesso!');
          } else {
            showToast('Erro ao salvar: ' + (json.error || 'Desconhecido'), 'error');
          }
        } catch (err) {
          showToast('Erro de conexão ao salvar: ' + err.message, 'error');
        }
      }

      async function toggleEvent(start) {
        let broadcast = false;
        if (start) {
          broadcast = confirm('Deseja enviar o anúncio oficial no canal de anúncios do Discord ao iniciar?');
        } else {
          if (!confirm('Tem certeza de que deseja encerrar o evento agora? Os crons e coletores serão desligados.')) return;
        }

        try {
          const res = await fetch('/api/admin/sazonal/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ active: start, broadcast })
          });
          const json = await res.json();
          if (json.success) {
            showToast(start ? 'Evento iniciado com sucesso!' : 'Evento encerrado com sucesso!');
            setTimeout(() => location.reload(), 1000);
          } else {
            showToast('Erro: ' + (json.error || 'Falha ao alterar estado'), 'error');
          }
        } catch (err) {
          showToast('Erro: ' + err.message, 'error');
        }
      }

      async function triggerManualDrop() {
        if (!confirm('Deseja disparar um drop de baú de teste imediatamente no canal configurado?')) return;
        try {
          const res = await fetch('/api/admin/sazonal/trigger-drop', { method: 'POST' });
          const json = await res.json();
          showToast(json.message || 'Drop acionado!', json.success ? 'success' : 'error');
        } catch (err) {
          showToast('Erro: ' + err.message, 'error');
        }
      }

      async function triggerManualArtTally() {
        if (!confirm('Deseja apurar as artes da semana cadastradas agora?')) return;
        try {
          const res = await fetch('/api/admin/sazonal/trigger-art', { method: 'POST' });
          const json = await res.json();
          showToast(json.message || 'Apuração executada!', json.success ? 'success' : 'error');
        } catch (err) {
          showToast('Erro: ' + err.message, 'error');
        }
      }

      // Inicializa slots, chips e preview
      renderCurrencySlot();
      renderChips('dropDecoys');
      renderChips('artOfWeek');
      renderChips('trickOrTreat');
      renderChips('dailyClaim');
      updateLivePreview();
    </script>
  </body>
</html>
