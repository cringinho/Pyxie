{
  "pyxie-architectural-guardrail": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "bash \".agents/hooks/pre-tool-validator.sh\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
