# ==============================================================================
# 💖 Bot Kuromi / Cringelândia — Exemplo de Variáveis de Ambiente
# ==============================================================================
# Renomeie ou copie este arquivo para `.env` e preencha com suas chaves.

# 1. Token do Bot no Discord Developer Portal (Obrigatório)
# Obtenha em: https://discord.com/developers/applications
DISCORD_TOKEN=seu_discord_token_aqui

# 2. Client ID da Aplicação no Discord (Obrigatório para registrar Slash Commands)
DISCORD_CLIENT_ID=seu_client_id_aqui

# 3. Porta e Host do Painel Web Local/Produção (Opcional, padrão: 3000 / 0.0.0.0)
PORT=3000
HOST=0.0.0.0

# 4. URL Base pública opcional para assets externos (Opcional)
TAROT_IMAGE_BASE_URL=


# 5. Top.gg (Opcional)
# Segredo do webhook de votos: o mesmo valor do campo "Authorization" em top.gg → Webhooks.
# Sem ele, o webhook recusa todos os votos (nenhum feijão é entregue).
TOPGG_WEBHOOK_AUTH=
# Token da API do Top.gg (top.gg → Webhooks/API) para publicar a contagem de servidores.
TOPGG_API_TOKEN=

# 6. Outras listas de bots (Opcional). Cada lista só recebe a contagem se o token existir.
DISCORDBOTLIST_TOKEN=
DISCORDS_TOKEN=
DISCORD_BOTS_GG_TOKEN=

# Passe da Pyxie (/py-pass): pagamento do Premium. Sem estas chaves, cada forma fica desligada.
# Mercado Pago (Pix e cartão, R$ 5): token de produção e segredo da assinatura do webhook
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# PayPal (US$ 3): credenciais do app REST; PAYPAL_ENV = sandbox ou live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Endereço público do site (webhook e retorno do pagamento) e segredo dos links assinados do Passe
PASS_PUBLIC_URL=https://pyxie.com.br
PASS_TOKEN_SECRET=
