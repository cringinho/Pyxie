{
  "name": "botmelody",
  "version": "1.0.0",
  "description": "Bot de Discord oficial da Cringelândia",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "bot": "node index.js",
    "web": "node server.js",
    "dev": "node server.js",
    "register": "node src/registerSlashCommands.js",
    "test": "node tests/run.js",
    "smoke": "node scripts/smoke_all_commands.js",
    "deploy": "node scripts/deployLocal.js",
    "build:client": "npm --prefix client run build",
    "test:fast": "node tests/run.js --changed",
    "test:gate": "node tests/run.js --gate",
    "test:map": "node tests/run.js --map",
    "test:file": "node tests/run.js --only",
    "test:steps": "node scripts/sync-test-steps.js",
    "test:steps:write": "node scripts/sync-test-steps.js --write"
  },
  "keywords": [
    "discord",
    "bot"
  ],
