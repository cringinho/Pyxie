    "@resvg/resvg-js": "^2.6.2",
    "compression": "^1.8.2",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.4",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "quill": "^2.0.3",
    "satori": "^0.35.0",
    "sharp": "^0.35.5",
    "turndown": "^7.2.0"
  },
